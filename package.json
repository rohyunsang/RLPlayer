{
  "name": "rlplayer",
  "version": "0.1.0",
  "description": "RLPlayer - a free, ad-free, no-nag Windows video player powered by mpv",
  "main": "./out/main/index.js",
  "author": "rohyunsang",
  "license": "MIT",
  "private": true,
  "scripts": {
    "fetch:mpv": "node scripts/fetch-mpv.mjs",
    "postinstall": "node scripts/fetch-mpv.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --publish never",
    "test": "node --test src/main/services/*.test.ts",
    "verify:sort": "node scripts/verify-natural-sort.mjs",
    "make:icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "7zip-bin": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
